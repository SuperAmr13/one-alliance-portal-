generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  playerId           String    @unique
  inGameName         String
  passwordHash       String
  role               Role      @default(MEMBER)
  approved           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mustChangePassword Boolean   @default(false)
  profileImageUrl    String?
  news               News[]
  reports            Report[]
  sessions           Session[]
}

model Report {
  id              String        @id @default(cuid())
  userId          String
  heroPower       BigInt
  firstSquadPower BigInt
  firstSquadType  SquadType
  heroPowerImage  String
  wallImage       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cycleId         String
  cycle           AllianceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId])
}

model AllianceCycle {
  id             String   @id @default(cuid())
  name           String
  weekNumber     Int      @unique
  isCurrent      Boolean  @default(false)
  isOpen         Boolean  @default(true)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  autoMode       Boolean  @default(true)
  manualOverride Boolean  @default(false)
  reports        Report[]
}

model AllianceSettings {
  id             Int      @id @default(1)
  cycleStartDay  Int      @default(4)
  cycleEndDay    Int      @default(6)
  cycleStartHour Int      @default(0)
  cycleEndHour   Int      @default(23)
  autoMode       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  pinned    Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  MEMBER
  R4
  R5
  OWNER
}

enum SquadType {
  AIRCRAFT
  TANKS
  MISSILES
}


